# Copie este archivo con el nombre .env (en esta misma carpeta) y llene los valores.
# NUNCA pegue estos valores en un chat, correo o captura de pantalla.

# Dirección de RAPIFIX (no la cambie)
RAPIFIX_WORKER_URL=https://us-central1-rapifix-prod-a1b2c.cloudfunctions.net/waWorker

# Clave de conexión: RAPIFIX -> Configuración -> WhatsApp automático -> Generar clave de conexión
RAPIFIX_WORKER_TOKEN=

# OpenWA en esta misma computadora
OPENWA_URL=http://localhost:2785
# API key de OpenWA (panel de OpenWA -> API Keys)
OPENWA_API_KEY=
# Nombre (o id) de la sesión creada en OpenWA
OPENWA_SESSION=rapifix
