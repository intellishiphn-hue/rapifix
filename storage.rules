rules_version = '2';

// RAPIFIX - Reglas de Firebase Storage
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function inTenant(tid) {
      return signedIn() && request.auth.token.tid == tid && request.auth.token.role is string;
    }
    function hasRole(tid, roles) { return inTenant(tid) && request.auth.token.role in roles; }
    function isImage() { return request.resource.contentType.matches('image/(jpeg|png|webp)'); }
    function maxMB(mb) { return request.resource.size < mb * 1024 * 1024; }
    // Un archivo ya subido no se reemplaza: "create" solo cuando todavía no existe

    // Fotos de vehículos
    match /tenants/{tid}/vehicles/{vehicleId}/photos/{fileName} {
      allow read: if inTenant(tid);
      allow create: if resource == null && hasRole(tid, ['admin', 'manager', 'reception', 'seller']) && isImage() && maxMB(10);
      allow update: if false;
      allow delete: if hasRole(tid, ['admin', 'manager']);
    }

    // Fotos de órdenes de trabajo: recepción, diagnóstico, antes, durante, después
    match /tenants/{tid}/workOrders/{orderId}/photos/{fileName} {
      function order() {
        return firestore.get(/databases/(default)/documents/tenants/$(tid)/workOrders/$(orderId)).data;
      }
      allow read: if inTenant(tid);
      allow create: if resource == null && isImage() && maxMB(10) && (
        hasRole(tid, ['admin', 'manager', 'reception'])
        || (hasRole(tid, ['technician']) && request.auth.uid in order().technicianIds)
      );
      allow update: if false;
      allow delete: if hasRole(tid, ['admin', 'manager']);
    }

    // Fotos opcionales del carwash: ingreso y salida de cada lavado (el lavador también sube)
    match /tenants/{tid}/carwashWashes/{washId}/photos/{fileName} {
      allow read: if hasRole(tid, ['admin', 'manager', 'reception', 'seller', 'washer']);
      allow create: if resource == null && isImage() && maxMB(10)
        && hasRole(tid, ['admin', 'manager', 'reception', 'seller', 'washer'])
        && firestore.exists(/databases/(default)/documents/tenants/$(tid)/carwashWashes/$(washId));
      allow update: if false;
      allow delete: if hasRole(tid, ['admin', 'manager']);
    }

    // Logo del taller (lectura pública: se muestra en el portal del cliente y en PDFs)
    match /tenants/{tid}/branding/{fileName} {
      allow read: if true;
      allow write: if hasRole(tid, ['admin', 'manager']) && isImage() && maxMB(2);
    }

    // Comprobantes de gastos (foto o PDF): solo administración y gerencia
    match /tenants/{tid}/expenses/{fileName} {
      allow read: if hasRole(tid, ['admin', 'manager']);
      allow create: if resource == null && hasRole(tid, ['admin', 'manager']) && maxMB(10)
        && (isImage() || request.resource.contentType == 'application/pdf');
      allow update, delete: if false;
    }

    // Comprobantes de pago (transferencias, depósitos, vouchers de tarjeta): caja
    match /tenants/{tid}/paymentReceipts/{fileName} {
      allow read: if hasRole(tid, ['admin', 'manager', 'reception', 'seller']);
      allow create: if resource == null && hasRole(tid, ['admin', 'manager', 'reception', 'seller']) && maxMB(10)
        && (isImage() || request.resource.contentType == 'application/pdf');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
