# Copiar como apps/web/.env.local (desarrollo) y completar con la config web de Firebase.
# Se obtiene con:
#   firebase apps:sdkconfig WEB <APP_ID> --project <PROJECT_ID>
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Identificador del taller (multi-taller). Para RAPIFIX: rapifix
VITE_TENANT_ID=rapifix

# true = usar Firebase Emulator Suite local en lugar de la nube
VITE_USE_EMULATORS=false
