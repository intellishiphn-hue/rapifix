rules_version = '2';

// ============================================================================
// RAPIFIX - Reglas de seguridad de Firestore
// La seguridad real vive aquí y en Cloud Functions. Ocultar botones en la
// interfaz es solo comodidad visual.
//
// Roles (custom claims del token): admin, manager, reception, technician,
// warehouse, seller. Claim "tid" = taller (multi-tenant).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function inTenant(tid) {
      return signedIn() && request.auth.token.tid == tid && request.auth.token.role is string;
    }
    function hasRole(tid, roles) { return inTenant(tid) && role() in roles; }

    function writers() { return ['admin', 'manager', 'reception', 'seller']; }
    function managers() { return ['admin', 'manager']; }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function unchanged(field) {
      return (field in existing()) == (field in incoming())
        && (!(field in existing()) || incoming()[field] == existing()[field]);
    }

    // Metadatos obligatorios en toda escritura
    function validCreateMeta() {
      return incoming().createdBy == request.auth.uid
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
    }
    function validUpdateMeta() {
      return unchanged('createdBy') && unchanged('createdAt')
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
    }

    // ---------- Usuarios (perfiles). Solo Cloud Functions escriben. ----------
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || (resource.data.tid == request.auth.token.tid && role() in ['admin', 'manager'])
      );
      allow write: if false;
    }

    match /tenants/{tid} {
      allow read: if inTenant(tid);
      allow write: if false;

      // ---------- Clientes ----------
      function validCustomer(d) {
        return d.keys().hasOnly([
            'firstName', 'lastName', 'fullName', 'phone', 'whatsapp', 'email', 'idNumber', 'rtn',
            'address', 'city', 'notes', 'status', 'vehicleCount', 'openOrders', 'balanceDue',
            'lastVisitAt', 'searchKeywords', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
          ])
          && isStr(d.firstName, 1, 60)
          && isStr(d.lastName, 1, 60)
          && isStr(d.fullName, 1, 130)
          && isStr(d.phone, 8, 20)
          && isStr(d.whatsapp, 0, 20)
          && isStr(d.email, 0, 120)
          && isStr(d.idNumber, 0, 20)
          && isStr(d.rtn, 0, 20)
          && isStr(d.address, 0, 250)
          && isStr(d.city, 0, 60)
          && isStr(d.notes, 0, 1000)
          && d.status in ['active', 'inactive']
          && d.searchKeywords is list && d.searchKeywords.size() <= 200;
      }

      match /customers/{customerId} {
        allow read: if inTenant(tid);
        allow create: if hasRole(tid, writers())
          && validCustomer(incoming())
          && validCreateMeta()
          && incoming().vehicleCount == 0
          && incoming().openOrders == 0
          && incoming().balanceDue == 0;
        // Contadores y saldos solo los cambian Cloud Functions
        allow update: if hasRole(tid, writers())
          && validCustomer(incoming())
          && validUpdateMeta()
          && unchanged('vehicleCount') && unchanged('openOrders')
          && unchanged('balanceDue') && unchanged('lastVisitAt');
        allow delete: if false; // se desactivan, nunca se borran
      }

      // ---------- Vehículos ----------
      function validVehicle(d) {
        return d.keys().hasOnly([
            'customerId', 'customer', 'make', 'model', 'year', 'color', 'plate', 'vin', 'mileage',
            'mileageUpdatedAt', 'fuelType', 'engine', 'transmission', 'notes', 'coverPhotoUrl',
            'photoCount', 'archived', 'searchKeywords', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
          ])
          && isStr(d.customerId, 1, 128)
          && d.customer is map
          && isStr(d.make, 1, 40)
          && isStr(d.model, 1, 60)
          && d.year is int && d.year >= 1950 && d.year <= 2100
          && isStr(d.color, 0, 30)
          && isStr(d.plate, 2, 12)
          && isStr(d.vin, 0, 20)
          && d.mileage is int && d.mileage >= 0 && d.mileage <= 2000000
          && d.fuelType in ['gasolina', 'diesel', 'hibrido', 'electrico', 'gas']
          && isStr(d.engine, 0, 40)
          && d.transmission in ['automatica', 'manual', 'cvt', 'otra']
          && isStr(d.notes, 0, 1000)
          && isStr(d.coverPhotoUrl, 0, 2000)
          && d.archived is bool
          && d.searchKeywords is list && d.searchKeywords.size() <= 200
          // El dueño debe existir en el mismo taller
          && exists(/databases/$(database)/documents/tenants/$(tid)/customers/$(d.customerId));
      }

      match /vehicles/{vehicleId} {
        allow read: if inTenant(tid);
        allow create: if hasRole(tid, writers())
          && validVehicle(incoming())
          && validCreateMeta()
          && incoming().photoCount == 0;
        allow update: if hasRole(tid, writers())
          && validVehicle(incoming())
          && validUpdateMeta()
          && unchanged('photoCount');
        allow delete: if false;

        // Historial de kilometraje: solo se agrega, nunca se edita ni borra
        match /mileageLog/{entryId} {
          allow read: if inTenant(tid);
          allow create: if hasRole(tid, writers())
            && incoming().keys().hasOnly(['mileage', 'source', 'note', 'at', 'by', 'byName'])
            && incoming().mileage is int && incoming().mileage >= 0
            && incoming().source in ['manual', 'reception', 'delivery']
            && isStr(incoming().note, 0, 200)
            && incoming().by == request.auth.uid
            && incoming().at == request.time;
          allow update, delete: if false;
        }

        match /photos/{photoId} {
          allow read: if inTenant(tid);
          allow create: if hasRole(tid, writers())
            && incoming().keys().hasOnly(['url', 'storagePath', 'caption', 'at', 'by', 'byName'])
            && isStr(incoming().url, 1, 2000)
            && isStr(incoming().storagePath, 1, 300)
            && incoming().storagePath.matches('tenants/' + tid + '/vehicles/' + vehicleId + '/photos/.*')
            && isStr(incoming().caption, 0, 200)
            && incoming().by == request.auth.uid
            && incoming().at == request.time;
          allow update: if hasRole(tid, writers())
            && incoming().diff(existing()).affectedKeys().hasOnly(['caption'])
            && isStr(incoming().caption, 0, 200);
          allow delete: if hasRole(tid, managers());
        }
      }

      // ---------- Órdenes de trabajo (FASE 2) ----------
      // Solo Cloud Functions escriben la orden y su historial. El técnico
      // únicamente ve las órdenes donde está asignado.
      function canSeeOrder(data) {
        return hasRole(tid, ['admin', 'manager', 'reception', 'warehouse', 'seller'])
          || (inTenant(tid) && role() == 'technician' && request.auth.uid in data.technicianIds);
      }
      function canWorkOrder(data) {
        return hasRole(tid, ['admin', 'manager', 'reception'])
          || (inTenant(tid) && role() == 'technician' && request.auth.uid in data.technicianIds);
      }

      match /workOrders/{orderId} {
        function parentOrder() {
          return get(/databases/$(database)/documents/tenants/$(tid)/workOrders/$(orderId)).data;
        }

        allow read: if canSeeOrder(resource.data);
        allow write: if false;

        match /events/{eventId} {
          allow read: if canSeeOrder(parentOrder());
          allow write: if false;
        }

        match /photos/{photoId} {
          allow read: if canSeeOrder(parentOrder());
          allow create: if canWorkOrder(parentOrder())
            && incoming().keys().hasOnly(['url', 'storagePath', 'stage', 'angle', 'caption', 'visibleToCustomer', 'by', 'byName', 'at'])
            && isStr(incoming().url, 1, 2000)
            && isStr(incoming().storagePath, 1, 300)
            && incoming().storagePath.matches('tenants/' + tid + '/workOrders/' + orderId + '/photos/.*')
            && incoming().stage in ['reception', 'diagnosis', 'before', 'during', 'after', 'damage']
            && isStr(incoming().angle, 0, 30)
            && isStr(incoming().caption, 0, 200)
            && incoming().visibleToCustomer is bool
            && incoming().by == request.auth.uid
            && incoming().at == request.time;
          allow update: if canWorkOrder(parentOrder())
            && incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'visibleToCustomer', 'stage'])
            && isStr(incoming().caption, 0, 200)
            && incoming().visibleToCustomer is bool;
          allow delete: if hasRole(tid, managers());
        }
      }

      // ---------- Cotizaciones (FASE 3): solo las escriben Cloud Functions ----------
      match /quotes/{quoteId} {
        allow read: if canSeeOrder(resource.data);
        allow write: if false;
      }

      // ---------- Catálogo e inventario (FASE 4) ----------
      function validProduct(d) {
        return d.keys().hasOnly([
            'sku', 'name', 'category', 'brand', 'supplier', 'unit', 'price', 'stock', 'minStock', 'location',
            'taxable', 'active', 'searchKeywords', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
          ])
          && isStr(d.sku, 0, 40) && isStr(d.name, 2, 120) && isStr(d.category, 0, 60) && isStr(d.brand, 0, 60)
          && isStr(d.supplier, 0, 80) && isStr(d.unit, 1, 20) && isStr(d.location, 0, 60)
          && d.price is int && d.price >= 0 && d.minStock is number && d.minStock >= 0
          && d.taxable is bool && d.active is bool
          && d.searchKeywords is list && d.searchKeywords.size() <= 200;
      }
      match /products/{productId} {
        allow read: if inTenant(tid);
        // La existencia (stock) solo la cambian Cloud Functions por movimientos de inventario
        allow create: if hasRole(tid, ['admin', 'manager', 'warehouse']) && validProduct(incoming()) && validCreateMeta() && incoming().stock == 0;
        allow update: if hasRole(tid, ['admin', 'manager', 'warehouse']) && validProduct(incoming()) && validUpdateMeta() && unchanged('stock');
        allow delete: if false;
      }
      // Costos: técnicos, recepción y vendedores no pueden verlos
      match /productCosts/{productId} {
        allow read: if hasRole(tid, ['admin', 'manager', 'warehouse']);
        allow write: if hasRole(tid, ['admin', 'manager', 'warehouse'])
          && incoming().keys().hasOnly(['cost', 'avgCost', 'lastPurchaseCost', 'updatedAt'])
          && incoming().cost is int && incoming().cost >= 0;
      }
      match /services/{serviceId} {
        allow read: if inTenant(tid);
        allow create, update: if hasRole(tid, ['admin', 'manager'])
          && incoming().keys().hasOnly(['code', 'name', 'category', 'price', 'estimatedHours', 'taxable', 'active', 'searchKeywords', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && isStr(incoming().name, 2, 120) && incoming().price is int && incoming().price >= 0
          && incoming().taxable is bool && incoming().active is bool
          && (request.method == 'create' ? validCreateMeta() : validUpdateMeta());
        allow delete: if false;
      }
      match /inventoryMovements/{movementId} {
        allow read: if hasRole(tid, ['admin', 'manager', 'warehouse', 'reception']);
        allow write: if false;
      }

      // ---------- Pagos y ventas (FASE 4): solo Cloud Functions ----------
      match /payments/{paymentId} {
        allow read: if hasRole(tid, ['admin', 'manager', 'reception', 'seller']);
        allow write: if false;
      }
      match /sales/{saleId} {
        allow read: if hasRole(tid, ['admin', 'manager', 'reception', 'seller']);
        allow write: if false;
      }
      // Cobros en línea (ROKI): los crea y confirma solo el servidor.
      // tenants/{tid}/private/* (llaves de ROKI) y rokiEvents quedan cerrados por la regla final.
      match /onlinePayments/{opId} {
        allow read: if hasRole(tid, ['admin', 'manager', 'reception', 'seller']);
        allow write: if false;
      }

      // Directorio del personal (nombres y roles para asignar técnicos). Lo mantiene el servidor.
      match /staffDirectory/{uid} {
        allow read: if inTenant(tid);
        allow write: if false;
      }

      // ---------- Configuración ----------
      match /settings/{docId} {
        allow read: if inTenant(tid);
        allow write: if hasRole(tid, managers())
          && incoming().updatedBy == request.auth.uid
          && incoming().updatedAt == request.time;
      }

      // ---------- Auditoría: solo la escriben Cloud Functions ----------
      match /auditLogs/{logId} {
        allow read: if hasRole(tid, managers());
        allow write: if false;
      }

      // ---------- Contadores y metadatos internos: solo Cloud Functions ----------
      match /counters/{docId} {
        allow read: if inTenant(tid);
        allow write: if false;
      }
      match /meta/{docId} {
        allow read, write: if false;
      }
    }

    // ---------- Portal público del cliente (FASE 3) ----------
    // Copia sanitizada de la orden. Se lee solo con el token exacto (link del cliente);
    // listar o adivinar portales es imposible. Solo la escriben Cloud Functions.
    match /publicPortal/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Todo lo demás está cerrado por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
